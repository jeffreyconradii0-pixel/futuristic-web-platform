# Production inbox. When this is set, the contact form POSTs JSON to it.
# Leave it empty in local development to write inquiries to .data/contact-submissions.jsonl.
CONTACT_WEBHOOK_URL=

# Optional bearer token sent with the webhook request.
CONTACT_WEBHOOK_TOKEN=

# Public site origin used for canonical URLs, the sitemap, and Open Graph.
# Change this if the production domain is not futuristicworld.us.
# The value is read from src/config/site.ts (site.url), not from this file.
